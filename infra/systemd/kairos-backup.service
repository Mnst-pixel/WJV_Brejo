[Unit]
Description=Kairós encrypted backup and isolated restore verification
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/kairos/current/scripts/backup-routine.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=5h
TimeoutStopSec=90s
KillMode=control-group

[Install]
WantedBy=multi-user.target
